#include "Shared.xcconfig"
// Debug: diagnostics on, DEBUG compilation conditions for the
// #if DEBUG diagnostics section in Settings.
// ZYRAXIS_BACKEND_ENV is an informational build marker only — the runtime
// backend environment is selected in SettingsStore (Dev/Staging/Prod).
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1
ENABLE_TESTABILITY = YES
ZYRAXIS_BACKEND_ENV = development
