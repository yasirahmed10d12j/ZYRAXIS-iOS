<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>ZYRAXIS</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- NOTE: Identifier/Executable/Name expand from build settings at build
         time (same values as PRODUCT_BUNDLE_IDENTIFIER / EXECUTABLE_NAME /
         PRODUCT_NAME, and INFOPLIST_KEY_CFBundleIdentifier in project.pbxproj).
         Single source of truth: the build settings. A custom Info.plist does
         NOT get these keys synthesized — the simulator installer and archive
         validation both require them present. -->
    <key>CFBundleShortVersionString</key>
    <string>0.5.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
    <key>NSMicrophoneUsageDescription</key>
    <string>ZYRAXIS uses the microphone for voice capture and optional live transcription. Audio levels animate the core.</string>
    <key>NSCameraUsageDescription</key>
    <string>ZYRAXIS will use the camera for future visual analysis. Phase 4 requests permission only.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>ZYRAXIS uses speech recognition for optional live transcription of your voice commands. Enable it in Settings to talk to ZYRAXIS.</string>
</dict>
</plist>
